{{ header }}
<main id="content">
  {{ content_top }}

  {% if breadcrumbs is defined and breadcrumbs|length %}
    {% set bc_home = breadcrumbs|first %}
    {% set bc_rest = breadcrumbs|slice(1) %}
    {% set bc_items = [] %}
    {% for b in bc_rest %}
      {% set bc_items = bc_items|merge([{ name: b.text, url: b.href }]) %}
    {% endfor %}

    {% include '@termopab/components/breadcrumbs/_breadcrumbs.twig' with {
      home: { url: bc_home.href, name: bc_home.text },
      breadcrumbs: bc_items,
      background: "black"
    } %}
  {% endif %}

  {% include '@termopab/sections/shared/contacts/_contacts.twig' with {
    contacts_title: contacts_title|default(''),
    contacts_address_1: contacts_address_1|default(''),
    contacts_address_2: contacts_address_2|default(''),
    telephones: telephones|default([]),
    email: email|default(''),
    footer_social_links: footer_social_links|default({}),
    schedule: schedule|default(''),
    base: base|default('')
  } %}

  {% include '@termopab/sections/shared/map-fullwidth/_map-fullwidth.twig' with {
    map_iframe: contacts_map_iframe|default('')
  } %}

  {{ content_bottom }}
</main>
{{ footer }}