<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ title }}</title>

    <base href="{{ base }}"/>

    {% if description %}
        <meta name="description" content="{{ description }}"/>
    {% endif %}
    {% if keywords %}
        <meta name="keywords" content="{{ keywords }}"/>
    {% endif %}

    <link rel="stylesheet" href="{{base}}extension/termopab/catalog/view/stylesheet/theme.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet"> #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dialog-polyfill/0.5.6/dialog-polyfill.min.css">

    {% for link in links %}
        <link href="{{ link.href }}" rel="{{ link.rel }}"/>
    {% endfor %}
    {% for analytic in analytics %}
        {{ analytic }}
    {% endfor %}
    {% if icon %}
        <link rel="icon" href="{{ icon }}" type="image/png">
    {% endif %}
    
    <script src="{{base}}extension/termopab/catalog/view/javascript/common.js" type="text/javascript"></script>

</head>

<body class="{{ pageClass }}">
    <div class="wrapper">
        <header class="header">
            <div class="container">
                <div class="header__left">
                    <div class="header__logo">
                        {% if logo %}
                            <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}"/></a>
                        {% else %}
                            <span><a href="{{ home }}">{{ name }}</a></span>
                        {% endif %}
                    </div>
                    {% set header_phones = (telephones|default([]))|length > 0 ? (telephones) : ((telephone|default('')) ? [telephone] : []) %}
                    {% if header_phones|length > 0 %}
                    <div class="header__phones">
                        <ul>
                            {% for phone in header_phones %}
                            <li><a href="tel:{{ phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ phone }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>
                <div class="header__right">
                    <ul class="header__socials">
                        {% set header_links = header_social_links|default(social_links|default({})) %}
                        {% for key in ['instagram', 'whatsapp', 'telegram', 'facebook', 'youtube'] %}
                            {% if header_links[key] is defined and header_links[key] is not same as('') %}
                                <li><a href="{{ header_links[key] }}" target="_blank" rel="noopener noreferrer" class="social-icon"><svg class="icon"><use href="{{ base }}extension/termopab/catalog/view/image/icons/icons.svg#icon-{{ key }}"></use></svg></a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                    <div class="header__dropdowns">
                        {{ currency }}
                        {{ language }}
                    </div>
                    <div class="header__nav">
                        <button
                                class="menu-button"
                                aria-expanded="false"
                                aria-controls="mobile-menu"
                            >
                            <span class="burger"></span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

 {% include '@termopab/components/menu/_menu.twig' %} 