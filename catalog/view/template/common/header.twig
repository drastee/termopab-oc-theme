<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ title }}</title>

    <base href="{{ base }}"/>

    {% if description %}
        <meta name="description" content="{{ description }}"/>
    {% endif %}
    {% if keywords %}
        <meta name="keywords" content="{{ keywords }}"/>
    {% endif %}

    <link rel="stylesheet" href="{{base}}extension/termopab/catalog/view/stylesheet/theme.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet"> #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dialog-polyfill/0.5.6/dialog-polyfill.min.css">

    {% for link in links %}
        <link href="{{ link.href }}" rel="{{ link.rel }}"/>
    {% endfor %}
    {% for analytic in analytics %}
        {{ analytic }}
    {% endfor %}
    {% if icon %}
        <link rel="icon" href="{{ icon }}" type="image/png">
    {% endif %}
</head>

<body class="{{ pageClass }}">
    <div class="wrapper">
        <header class="header">
            <div class="container">
                <div class="header__left">
                    <div class="header__logo">
                        {% if logo %}
                            <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}"/></a>
                        {% else %}
                            <span><a href="{{ home }}">{{ name }}</a></span>
                        {% endif %}
                    </div>
                    <div class="header__phones">
                        <ul>
                            <li><a href="tel:3806740991XX">+38 (067) 409-91-<span>XX</span></a></li>
                            <li><a href="tel:3806740991XX">+38 (067) 409-91-<span>XX</span></a></li>
                        </ul>
                    </div>
                </div>
                <div class="header__right">
                    <ul class="header__socials">
                        <li><a href="#" target="_blank" class="social-icon"><svg class="icon"><use href="/src/assets/icons/icons.svg#icon-instagram"></use></svg></a></li>
                        <li><a href="#" target="_blank" class="social-icon"><svg class="icon"><use href="/src/assets/icons/icons.svg#icon-facebook"></use></svg></a></li>
                        <li><a href="#" target="_blank" class="social-icon"><svg class="icon"><use href="/src/assets/icons/icons.svg#icon-youtube"></use></svg></a></li>

                    </ul>
                    <div class="header__dropdowns">
                        <div class="header__languages">
                            {% include '@termopab/components/dropdown/_dropdown.twig' with {
                                "selected": "UAH",
                                "options": ["USD","EUR","GBP"]
                            } %}
                        </div>
                        <div class="header__currency">
                            {% include '@termopab/components/dropdown/_dropdown.twig' with {
                            "selected": "UA",
                            "options": ["UA","EN","GE","FR"]
                            } %}
                        </div>
                    </div>
                    <div class="header__nav">
                        <button
                                class="menu-button"
                                aria-expanded="false"
                                aria-controls="mobile-menu"
                            >
                            <span class="burger"></span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

 {% include '@termopab/components/menu/_menu.twig' %} 