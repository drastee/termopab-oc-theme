{% if languages|length > 1 %}
<form id="form-language" action="{{ action }}" method="post" data-oc-toggle="ajax" class="header__languages">
    {% set language_options = [] %}
    {% for language in languages %}
        {% set language_options = language_options|merge([{ label: language.name, href: language.code }]) %}
    {% endfor %}
    {% include '@termopab/components/dropdown/_dropdown.twig' with {
        "selected": name,
        "options": language_options
    } %}
    <input type="hidden" name="code" value=""/>
    <input type="hidden" name="redirect" value="{{ redirect }}"/>
</form>
{% endif %}