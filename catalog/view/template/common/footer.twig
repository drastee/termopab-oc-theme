      <footer class="footer">
        <div class="container footer__top">

            <!-- LEFT -->
            <div class="footer__left">
                <h2 class="footer__brand">{{ brand|default(name)|upper }}</h2>

                {% include "@termopab/components/phones-styled/_phones-styled.twig" %}
                {% include "@termopab/components/shedule-styled/_shedule-styled.twig" %}

                {% set first_phone = (telephones|default([]))|first|default(telephone) %}
                {% if first_phone %}
                <a href="tel:{{ first_phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}" class="footer__button btn btn-transparent">{{ text_call_me }}</a>
                {% endif %}
                <hr>
                {% if email %}
                <a href="mailto:{{ email }}" class="footer__email">{{ email|upper }}</a>
                {% endif %}
            </div>

            <!-- RIGHT SIDE -->
            <div class="footer__right">
                <div class="footer__right-top">
                    <div class="footer__location">
                        {% if address %}
                        <p class="footer__address">
                            <svg class="footer__icon-location"><use href="#icon-location"></use></svg>
                            {{ address|nl2br }}
                        </p>
                        {% endif %}
                        {% if worknote %}
                        <p class="footer__worknote">{{ worknote }}</p>
                        {% endif %}
                    </div>
                    <div class="footer_socials_wrapper">
                        {% include "@termopab/components/social-buttons/_social-buttons.twig" %}  
                    </div>
                </div>
                <div class="footer__right-bottom">
                    <ul class="footer__menu">
                        {% for item in footer_menu|default([]) %}
                        <li><a href="{{ item.href }}">{{ item.name }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>


        </div>

        <!-- BOTTOM -->
        <div class="footer__bottom container">
            <div class="footer__bottom-inner">
                <div class="footer__copyright">
                    © 2025 Термопаб
                </div>

                <a href="#" class="footer__privacy">Політика конфіденційності</a>

                <div class="footer__payments">
                    <img src="{{ base }}extension/termopab/catalog/view/image/images/payments/privat.webp" alt="Privat">
                    <img src="{{ base }}extension/termopab/catalog/view/image/images/payments/visa.webp" alt="Visa">
                    <img src="{{ base }}extension/termopab/catalog/view/image/images/payments/liqpay.webp" alt="Liqpay">
                    <img src="{{ base }}extension/termopab/catalog/view/image/images/payments/mastercard.webp" alt="Mastercard">
                </div>
            </div>
        </div>
    </footer>


    </div>

    {% include "@termopab/components/modal-cart/_modal-cart.twig" %}
    
    <script type="module" src="{{base}}extension/termopab/catalog/view/javascript/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dialog-polyfill/0.5.6/dialog-polyfill.min.js"></script>
    
    
    {# Sprites #}
    {% include "@assets/icons/arrow.svg" %}
    {% include "@assets/icons/short-arrow.svg" %}
    {% include "@assets/icons/dropdown-arrow.svg" %}
    {% include "@assets/icons/location.svg" %}
    {% include "@assets/icons/360.svg" %}
    {% include "@assets/icons/play.svg" %}
</body>
</html>
