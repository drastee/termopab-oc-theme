<section class="cta-hop">
    <div class="container">

        <div class="cta-hop__image-wrapper">
            <picture>
                <source srcset="{{ image_welder_mob }}" media="(max-width: 1024px)">
                <img src="{{ image_welder }}" alt="">
            </picture>
            <video class="explosion" autoplay muted loop playsinline>
                <source src="{{ video_explosion }}" type="video/webm">
            </video>
        </div>

        <div class="cta-form">
            <h2 class="cta-form__title section-title">
                {{ title_first }}{% if title_rest|length > 0 %}<br>{% for line in title_rest %}<span>{{ line }}</span>{% endfor %}{% endif %}
            </h2>

            <div class="cta-form__wrapper">
                {% if social_block_enabled and (intro_text or social_links|length > 0) %}
                {% if intro_text %}<p>{{ intro_text }}</p>{% endif %}
                {% if social_links|length > 0 %}
                <ul class="social-buttons">
                    {% for key, url in social_links %}
                    <li><a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="icon social social-{{ key }}"></a></li>
                    {% endfor %}
                </ul>
                {% endif %}
                {% endif %}

                {% include '@components/callback-form/_callback-form.twig' with {
                    form_id: 'cta-hop-form',
                    form_label_name: form_label_name,
                    form_placeholder_name: form_placeholder_name,
                    form_label_phone: form_label_phone,
                    form_placeholder_phone: form_placeholder_phone,
                    form_button_text: form_button_text,
                    form_agreement: form_agreement|default('')
                } %}
            </div>
        </div>
    </div>
</section>
