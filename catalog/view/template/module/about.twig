<section class="about">
    <div class="container about__inner">

        <h2 class="section-title about__title">
            {{ title_first }}{% if title_rest|length > 0 %}<br>{% for line in title_rest %}<span>{{ line }}</span>{% endfor %}{% endif %}
        </h2>

        {% if description or button_text or facts|length > 0 %}
            <div class="about__content">

                <div class="about__text">
                    {% if description %}
                        <p>{{ description }}</p>
                    {% endif %}

                    {% if button_text %}
                        <a href="{{ button_url }}" class="button-play" target="_blank" rel="noopener">
                            <span class="button-play__icon">
                                <svg class="play-icon">
                                    <use xlink:href="#svg-play"></use>
                                </svg>
                            </span>
                            <span>{{ button_text }}</span>
                        </a>
                    {% endif %}
                </div>

                {% if facts|length > 0 %}
                    <div class="about__facts">
                        {% for fact in facts %}
                            <a class="about__fact" href="{{ fact.url }}">
                                <span class="about__fact-title">{{ fact.title }}</span>
                                {% if fact.text %}
                                    <p class="about__fact-text">{{ fact.text }}</p>
                                {% endif %}
                                <svg class="about__arrow"><use href="#icon-arrow"></use></svg>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>
