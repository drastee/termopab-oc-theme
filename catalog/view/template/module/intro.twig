<section class="intro">
    <div class="container intro__inner">
        <div class="intro__content">
            <p class="intro__title">{{ title }}</p>
            <p class="intro__text">{{ text }}</p>
        </div>
        <div class="intro__badge">
            <img src="{{ logo_url }}" class="logo-large js-rotate-item" alt="Termopab badge">
            <img src="{{ logo_shadow_url }}" class="logo-shadow" alt="Termopab badge">
        </div>
    </div>
</section>
