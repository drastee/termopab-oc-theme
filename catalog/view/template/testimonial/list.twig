{{ header }}
<main id="content">
  {{ content_top }}
  {% set bc_home = breadcrumbs|first %}
  {% set bc_rest = breadcrumbs|slice(1) %}
  {% set bc_items = [] %}
  {% for b in bc_rest %}
    {% set bc_items = bc_items|merge([{ name: b.text, url: b.href }]) %}
  {% endfor %}

  {% include '@termopab/components/breadcrumbs/_breadcrumbs.twig' with {
    home: { url: bc_home.href|default('/'), name: bc_home.text|default(text_home)|striptags|trim },
    breadcrumbs: bc_items
  } %}

  {% set testimonial_posts = [] %}
  {% for t in testimonials|default([]) %}
    {% set testimonial_posts = testimonial_posts|merge([t|merge({ title: t.name|default('') })]) %}
  {% endfor %}

  {% include '@termopab/sections/shared/posts/_posts.twig' with {
    filter: false,
    posts: testimonial_posts,
    pagination_data: pagination_data|default(null),
    empty_message: testimonials is empty ? text_empty : null
  } %}
  {{ content_bottom }}
</main>
{{ footer }}
