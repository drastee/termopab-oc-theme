{{ header }}
<main>
  {% set bc_home = breadcrumbs|first %}
  {% set bc_rest = breadcrumbs|slice(1) %}
  {% set bc_items = [] %}
  {% for b in bc_rest %}
    {% set bc_items = bc_items|merge([{ name: b.text, url: b.href }]) %}
  {% endfor %}

  {% include '@termopab/components/breadcrumbs/_breadcrumbs.twig' with {
    home: { url: bc_home.href|default('/'), name: bc_home.text|default(text_home)|striptags|trim },
    breadcrumbs: bc_items,
    background: breadcrumb_background|default('white')
  } %}

  {% include '@termopab/sections/shared/text-classic/_text-classic.twig' with {
    title: heading_title|default(''),
    content: description|default('')
  } %}
</main>
{{ footer }}
