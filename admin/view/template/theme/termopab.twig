  html += '</div>';
  $('#telephone-list').append(html);
});

$('#telephone-list').on('click', '.remove-telephone', function() {
  var rows = $('#telephone-list .telephone-row');
  if (rows.length > 1) {
    $(this).closest('.telephone-row').remove();
  }
});

// Menu item type toggle (main menu + footer)
$('#form-theme').on('change', '.menu-item-type', function() {
  var $row = $(this).closest('.menu-item-row');
  var type = $(this).val();
  $row.find('.menu-field-information').toggleClass('d-none', type !== 'information');
  $row.find('.menu-field-category').toggleClass('d-none', type !== 'category');
  $row.find('.menu-field-custom').toggleClass('d-none', type !== 'custom');
  $row.attr('data-type', type);
});
$('#tab-menu .menu-item-type, #tab-footer .menu-item-type').each(function() {
  $(this).trigger('change');
});

// Footer menu: use main vs configure
$('input[name="theme_termopab_footer_menu_use_main"]').on('change', function() {
  $('#footer-menu-items-wrap').toggleClass('d-none', $(this).val() === '1');
});

// Menu columns 1, 2, 3 - add item (unified structure)
function menuItemRowHtml(col, idx, langs, infos, cats, texts) {
  var infosArr = Array.isArray(infos) ? infos : (infos ? Object.values(infos) : []);
  var catsArr = Array.isArray(cats) ? cats : (cats ? Object.values(cats) : []);
  var langsArr = Array.isArray(langs) ? langs : (langs ? Object.values(langs) : []);
  var infoOpts = infosArr.map(function(i) { return '<option value="' + (i.information_id || '') + '">' + (i.title || '') + '</option>'; }).join('');
  var catOpts = catsArr.map(function(c) { return '<option value="' + (c.category_id || '') + '">' + (c.name || '') + '</option>'; }).join('');
  var langInputs = langsArr.map(function(l) {
    var img = (l.image || '').replace(/'/g, "\\'");
    return '<div class="d-flex align-items-center gap-2 mb-2"><img src="' + img + '" alt="" width="20" height="14" class="rounded flex-shrink-0"><input type="text" name="theme_termopab_menu_column' + col + '[' + idx + '][title][' + (l.language_id || '') + ']" placeholder="' + (texts.entry_menu_item_title || '') + '" class="form-control form-control-sm flex-grow-1"><input type="text" name="theme_termopab_menu_column' + col + '[' + idx + '][href][' + (l.language_id || '') + ']" placeholder="' + (texts.entry_menu_item_url || '') + '" class="form-control form-control-sm flex-grow-1"></div>';
  }).join('');
  return '<div class="list-group-item menu-item-row" data-type="category"><div class="row align-items-center"><div class="col-md-2"><select name="theme_termopab_menu_column' + col + '[' + idx + '][type]" class="form-select form-select-sm menu-item-type"><option value="category" selected>' + (texts.entry_menu_item_category || '') + '</option><option value="information">' + (texts.entry_menu_item_information || '') + '</option><option value="custom">' + (texts.entry_menu_item_custom || '') + '</option></select></div><div class="col-md-4 menu-field-information d-none"><select name="theme_termopab_menu_column' + col + '[' + idx + '][information_id]" class="form-select form-select-sm"><option value="">' + (texts.text_select || '') + '</option>' + infoOpts + '</select></div><div class="col-md-4 menu-field-category"><select name="theme_termopab_menu_column' + col + '[' + idx + '][category_id]" class="form-select form-select-sm"><option value="">' + (texts.text_select || '') + '</option>' + catOpts + '</select></div><div class="col-md-4 menu-field-custom d-none">' + langInputs + '</div><div class="col-md-2 d-flex gap-1"><button type="button" class="btn btn-outline-secondary btn-sm menu-item-up" title="' + (texts.button_up || '') + '"><i class="fa-solid fa-arrow-up"></i></button><button type="button" class="btn btn-outline-secondary btn-sm menu-item-down" title="' + (texts.button_down || '') + '"><i class="fa-solid fa-arrow-down"></i></button><button type="button" class="btn btn-outline-danger btn-sm menu-item-remove" title="' + (texts.button_remove || '') + '"><i class="fa-solid fa-minus"></i></button></div></div></div>';
}
var menuTexts = { entry_menu_item_information: '{{ entry_menu_item_information|escape('js') }}', entry_menu_item_category: '{{ entry_menu_item_category|escape('js') }}', entry_menu_item_custom: '{{ entry_menu_item_custom|escape('js') }}', entry_menu_item_title: '{{ entry_menu_item_title|escape('js') }}', entry_menu_item_url: '{{ entry_menu_item_url|escape('js') }}', text_select: '{{ text_select|escape('js') }}', button_up: '{{ button_up|escape('js') }}', button_down: '{{ button_down|escape('js') }}', button_remove: '{{ button_remove|escape('js') }}' };
var menuLangs = {{ (menu_languages|default([]))|json_encode|raw }};
var menuInfos = {{ (menu_informations|default([]))|json_encode|raw }};
var menuCats = {{ (categories_flat|default([]))|json_encode|raw }};
if (!Array.isArray(menuLangs)) menuLangs = Object.values(menuLangs || {});
if (!Array.isArray(menuInfos)) menuInfos = Object.values(menuInfos || {});
if (!Array.isArray(menuCats)) menuCats = Object.values(menuCats || {});

function menuAddItem(col) {
  var $container = $('#menu-column' + col + '-items');
  $container.find('.text-muted').remove();
  var idx = $container.find('.menu-item-row').length;
  var html = menuItemRowHtml(col, idx, menuLangs, menuInfos, menuCats, menuTexts);
  $container.append(html);
  $container.find('.menu-item-type').last().trigger('change');
}
$('#tab-menu').on('click', '.menu-column-add', function() { menuAddItem(parseInt($(this).data('column'), 10)); });

// Footer menu - add item
