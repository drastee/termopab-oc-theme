  var infoOpts = infosArr.map(function(i) { return '<option value="' + (i.information_id || '') + '">' + (i.title || '') + '</option>'; }).join('');
  var catOpts = catsArr.map(function(c) { return '<option value="' + (c.category_id || '') + '">' + (c.name || '') + '</option>'; }).join('');
  var langInputs = langsArr.map(function(l) {
    var img = (l.image || '').replace(/'/g, "\\'");
    return '<div class="d-flex align-items-center gap-2 mb-2"><img src="' + img + '" alt="" width="20" height="14" class="rounded flex-shrink-0"><input type="text" name="theme_termopab_footer_menu[' + idx + '][title][' + (l.language_id || '') + ']" placeholder="' + (texts.entry_menu_item_title || '') + '" class="form-control form-control-sm flex-grow-1"><input type="text" name="theme_termopab_footer_menu[' + idx + '][href][' + (l.language_id || '') + ']" placeholder="' + (texts.entry_menu_item_url || '') + '" class="form-control form-control-sm flex-grow-1"></div>';
  }).join('');
  return '<div class="list-group-item menu-item-row" data-type="category"><div class="row align-items-center"><div class="col-md-2"><select name="theme_termopab_footer_menu[' + idx + '][type]" class="form-select form-select-sm menu-item-type"><option value="category" selected>' + (texts.entry_menu_item_category || '') + '</option><option value="information">' + (texts.entry_menu_item_information || '') + '</option><option value="custom">' + (texts.entry_menu_item_custom || '') + '</option></select></div><div class="col-md-4 menu-field-information d-none"><select name="theme_termopab_footer_menu[' + idx + '][information_id]" class="form-select form-select-sm"><option value="">' + (texts.text_select || '') + '</option>' + infoOpts + '</select></div><div class="col-md-4 menu-field-category"><select name="theme_termopab_footer_menu[' + idx + '][category_id]" class="form-select form-select-sm"><option value="">' + (texts.text_select || '') + '</option>' + catOpts + '</select></div><div class="col-md-4 menu-field-custom d-none">' + langInputs + '</div><div class="col-md-2 d-flex gap-1"><button type="button" class="btn btn-outline-secondary btn-sm menu-item-up" title="' + (texts.button_up || '') + '"><i class="fa-solid fa-arrow-up"></i></button><button type="button" class="btn btn-outline-secondary btn-sm menu-item-down" title="' + (texts.button_down || '') + '"><i class="fa-solid fa-arrow-down"></i></button><button type="button" class="btn btn-outline-danger btn-sm menu-item-remove" title="' + (texts.button_remove || '') + '"><i class="fa-solid fa-minus"></i></button></div></div></div>';
}
$('#footer-menu-add').on('click', function() {
  var $container = $('#footer-menu-items');
  $container.find('.text-muted').remove();
  var idx = $container.find('.menu-item-row').length;
  var html = footerMenuItemRowHtml(idx, menuLangs, menuInfos, menuCats, menuTexts);
