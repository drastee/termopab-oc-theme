});

$('#form-theme').on('click', '.menu-item-remove', function() {
  $(this).closest('.menu-item-row').remove();
});
$('#form-theme').on('click', '.menu-item-up', function() {
  var $row = $(this).closest('.menu-item-row');
  var $prev = $row.prev('.menu-item-row');
  if ($prev.length) $prev.before($row);
});
$('#form-theme').on('click', '.menu-item-down', function() {
  var $row = $(this).closest('.menu-item-row');
  var $next = $row.next('.menu-item-row');
  if ($next.length) $next.after($row);
});

// Modal address field order: sync list to hidden input
function modalAddressFieldOrderSync() {
  var keys = [];
  $('#modal-address-field-order-list li[data-key]').each(function() { keys.push($(this).data('key')); });
  $('#input-modal-address-field-order').val(keys.join(','));
}
$('#tab-checkout').on('click', '.modal-address-field-up', function() {
  var $li = $(this).closest('li');
  var $prev = $li.prev('li');
  if ($prev.length) { $prev.before($li); modalAddressFieldOrderSync(); }
});
$('#tab-checkout').on('click', '.modal-address-field-down', function() {
  var $li = $(this).closest('li');
  var $next = $li.next('li');
  if ($next.length) { $next.after($li); modalAddressFieldOrderSync(); }
});

