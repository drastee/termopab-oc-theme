{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ install_project_tables }}" class="btn btn-secondary me-2" title="{{ text_install_project_tables }}"><i class="fa-solid fa-database"></i> {{ text_install_project_tables }}</a>
        <a href="{{ projects_list }}" class="btn btn-outline-primary me-2"><i class="fa-solid fa-folder-open"></i> {{ text_projects }}</a>
        <button type="submit" form="form-theme" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-paper-plane"></i> {{ text_quick_links }}</div>
      <div class="card-body">
        <a href="{{ projects_list }}" class="btn btn-outline-primary me-2"><i class="fa-solid fa-folder-open"></i> {{ text_projects }}</a>
        <a href="{{ projects_add }}" class="btn btn-outline-success me-2"><i class="fa-solid fa-plus"></i> {{ text_projects_add }}</a>
        <a href="{{ install_project_tables }}" class="btn btn-outline-secondary me-2" title="{{ text_install_project_tables }}"><i class="fa-solid fa-database"></i> {{ text_install_project_tables }}</a>
        <a href="{{ install_full_tables }}" class="btn btn-outline-secondary me-2" title="{{ text_install_full_tables }}"><i class="fa-solid fa-database"></i> {{ text_install_full_tables }}</a>
        <a href="{{ sync_events }}" class="btn btn-outline-info me-2" title="Синхронізувати події"><i class="fa-solid fa-sync"></i> Синхронізувати події</a>
        <hr class="my-3"/>
        <a href="{{ brewery_reviews_list }}" class="btn btn-outline-primary me-2"><i class="fa-solid fa-beer-mug-empty"></i> {{ text_brewery_reviews }}</a>
        <a href="{{ brewery_reviews_add }}" class="btn btn-outline-success me-2"><i class="fa-solid fa-plus"></i> {{ text_brewery_reviews_add }}</a>
        <a href="{{ brewery_reviews_add_permission }}" class="btn btn-warning" title="{{ text_brewery_reviews_add_permission }}"><i class="fa-solid fa-key"></i> {{ text_brewery_reviews_add_permission }}</a>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-theme" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-main" data-bs-toggle="tab" class="nav-link active">{{ tab_main }}</a></li>
            <li class="nav-item"><a href="#tab-header" data-bs-toggle="tab" class="nav-link">{{ tab_header }}</a></li>
            <li class="nav-item"><a href="#tab-footer" data-bs-toggle="tab" class="nav-link">{{ tab_footer }}</a></li>
            <li class="nav-item"><a href="#tab-menu" data-bs-toggle="tab" class="nav-link">{{ tab_menu }}</a></li>
            <li class="nav-item"><a href="#tab-delivery-payment" data-bs-toggle="tab" class="nav-link">{{ tab_delivery_payment }}</a></li>
            <li class="nav-item"><a href="#tab-exchange-return" data-bs-toggle="tab" class="nav-link">{{ tab_exchange_return }}</a></li>
            <li class="nav-item"><a href="#tab-checkout" data-bs-toggle="tab" class="nav-link">{{ tab_checkout }}</a></li>
            <li class="nav-item"><a href="#tab-about" data-bs-toggle="tab" class="nav-link">{{ tab_about }}</a></li>
            <li class="nav-item"><a href="#tab-status" data-bs-toggle="tab" class="nav-link">{{ tab_status }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-main" class="tab-pane active">
              <fieldset>
                <legend>{{ tab_main }}</legend>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_telephone }}</label>
                  <div class="col-sm-10">
                    <div id="telephone-list">
                      {% for phone in theme_termopab_telephones|default([]) %}
                      <div class="input-group mb-2 telephone-row">
                        <input type="text" name="theme_termopab_telephone[]" value="{{ phone }}" placeholder="{{ entry_telephone }}" class="form-control"/>
                        <button type="button" class="btn btn-outline-danger remove-telephone" title="{{ button_remove }}"><i class="fa-solid fa-minus"></i></button>
                      </div>
                      {% else %}
                      <div class="input-group mb-2 telephone-row">
                        <input type="text" name="theme_termopab_telephone[]" value="" placeholder="{{ entry_telephone }}" class="form-control"/>
                        <button type="button" class="btn btn-outline-danger remove-telephone" title="{{ button_remove }}"><i class="fa-solid fa-minus"></i></button>
                      </div>
                      {% endfor %}
                    </div>
                    <button type="button" id="add-telephone" class="btn btn-outline-primary btn-sm mt-1"><i class="fa-solid fa-plus"></i> {{ button_add }}</button>
                    <div class="form-text">{{ help_telephone }}</div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-email" class="col-sm-2 col-form-label">{{ entry_email }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_termopab_email" value="{{ theme_termopab_email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control"/>
                  </div>
                </div>
                <hr class="my-4">
                <h6 class="mb-3">{{ entry_social_links }}</h6>
                <div class="row mb-3">
                  <label for="input-social-instagram" class="col-sm-2 col-form-label">{{ entry_social_instagram }}</label>
                  <div class="col-sm-10">
                    <input type="url" name="theme_termopab_social_instagram" value="{{ theme_termopab_social_instagram|default('') }}" placeholder="https://instagram.com/..." id="input-social-instagram" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-social-whatsapp" class="col-sm-2 col-form-label">{{ entry_social_whatsapp }}</label>
                  <div class="col-sm-10">
                    <input type="url" name="theme_termopab_social_whatsapp" value="{{ theme_termopab_social_whatsapp|default('') }}" placeholder="https://wa.me/..." id="input-social-whatsapp" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-social-telegram" class="col-sm-2 col-form-label">{{ entry_social_telegram }}</label>
                  <div class="col-sm-10">
                    <input type="url" name="theme_termopab_social_telegram" value="{{ theme_termopab_social_telegram|default('') }}" placeholder="https://t.me/..." id="input-social-telegram" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-social-facebook" class="col-sm-2 col-form-label">{{ entry_social_facebook }}</label>
                  <div class="col-sm-10">
                    <input type="url" name="theme_termopab_social_facebook" value="{{ theme_termopab_social_facebook|default('') }}" placeholder="https://facebook.com/..." id="input-social-facebook" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-social-youtube" class="col-sm-2 col-form-label">{{ entry_social_youtube }}</label>
                  <div class="col-sm-10">
                    <input type="url" name="theme_termopab_social_youtube" value="{{ theme_termopab_social_youtube|default('') }}" placeholder="https://youtube.com/..." id="input-social-youtube" class="form-control"/>
                  </div>
                </div>
                <ul class="nav nav-tabs">
                  {% for language in languages %}
                    <li class="nav-item"><a href="#language-main-{{ language.language_id }}" data-bs-toggle="tab" class="nav-link{% if loop.first %} active{% endif %}"><img src="{{ language.image }}" title="{{ language.name }}"/> {{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content mt-3">
                  {% for language in languages %}
                    <div id="language-main-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                      <div class="row mb-3">
                        <label for="input-brand-{{ language.language_id }}" class="col-sm-2 col-form-label">{{ entry_brand }}</label>
                        <div class="col-sm-10">
                          <input type="text" name="theme_termopab_brand[{{ language.language_id }}]" value="{{ theme_termopab_brand[language.language_id] ?? '' }}" placeholder="{{ entry_brand }}" id="input-brand-{{ language.language_id }}" class="form-control"/>
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>
            </div>
            <div id="tab-header" class="tab-pane">
              <fieldset>
                <legend>{{ tab_header }}</legend>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_header_socials }}</label>
                  <div class="col-sm-10">
                    <div class="form-text mb-2">{{ help_header_socials }}</div>
                    <div class="d-flex flex-wrap gap-3">
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_header_social_instagram" value="1" id="header-social-instagram" class="form-check-input"{% if theme_termopab_header_social_instagram %} checked{% endif %}>
                        <label for="header-social-instagram" class="form-check-label">{{ entry_social_instagram }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_header_social_whatsapp" value="1" id="header-social-whatsapp" class="form-check-input"{% if theme_termopab_header_social_whatsapp %} checked{% endif %}>
                        <label for="header-social-whatsapp" class="form-check-label">{{ entry_social_whatsapp }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_header_social_telegram" value="1" id="header-social-telegram" class="form-check-input"{% if theme_termopab_header_social_telegram %} checked{% endif %}>
                        <label for="header-social-telegram" class="form-check-label">{{ entry_social_telegram }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_header_social_facebook" value="1" id="header-social-facebook" class="form-check-input"{% if theme_termopab_header_social_facebook %} checked{% endif %}>
                        <label for="header-social-facebook" class="form-check-label">{{ entry_social_facebook }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_header_social_youtube" value="1" id="header-social-youtube" class="form-check-input"{% if theme_termopab_header_social_youtube %} checked{% endif %}>
                        <label for="header-social-youtube" class="form-check-label">{{ entry_social_youtube }}</label>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>
            </div>
            <div id="tab-menu" class="tab-pane">
              <fieldset>
                <legend>{{ tab_menu }}</legend>
                <p class="text-muted mb-4">{{ help_menu_columns }}</p>
                {% for col in [1, 2, 3] %}
                <div class="row mb-4">
                  <label class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_menu_column' ~ col) }}</label>
                  <div class="col-sm-10">
                    <div id="menu-column{{ col }}-items" class="list-group">
                      {% for idx, item in attribute(_context, 'menu_column' ~ col) %}
                      <div class="list-group-item menu-item-row" data-type="{{ item.type|default('category') }}">
                        <div class="row align-items-center">
                          <div class="col-md-2">
                            <select name="theme_termopab_menu_column{{ col }}[{{ idx }}][type]" class="form-select form-select-sm menu-item-type">
                              <option value="category"{% if (item.type|default('category')) == 'category' %} selected{% endif %}>{{ entry_menu_item_category }}</option>
                              <option value="information"{% if (item.type|default('')) == 'information' %} selected{% endif %}>{{ entry_menu_item_information }}</option>
                              <option value="custom"{% if (item.type|default('')) == 'custom' %} selected{% endif %}>{{ entry_menu_item_custom }}</option>
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-information {{ (item.type|default('category')) != 'information' ? 'd-none' : '' }}">
                            <select name="theme_termopab_menu_column{{ col }}[{{ idx }}][information_id]" class="form-select form-select-sm">
                              <option value="">{{ text_select }}</option>
                              {% for info in informations %}
                              <option value="{{ info.information_id }}"{% if (item.information_id|default(0)) == info.information_id %} selected{% endif %}>{{ info.title }}</option>
                              {% endfor %}
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-category {{ (item.type|default('category')) != 'category' ? 'd-none' : '' }}">
                            <select name="theme_termopab_menu_column{{ col }}[{{ idx }}][category_id]" class="form-select form-select-sm">
                              <option value="">{{ text_select }}</option>
                              {% for cat in categories_flat %}
                              <option value="{{ cat.category_id }}"{% if (item.category_id|default(0)) == cat.category_id %} selected{% endif %}>{{ cat.name }}</option>
                              {% endfor %}
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-custom {{ (item.type|default('category')) != 'custom' ? 'd-none' : '' }}">
                            {% for lang in languages %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                              <img src="{{ lang.image }}" alt="" width="20" height="14" class="rounded flex-shrink-0">
                              <input type="text" name="theme_termopab_menu_column{{ col }}[{{ idx }}][title][{{ lang.language_id }}]" value="{{ item.title[lang.language_id]|default('') }}" placeholder="{{ entry_menu_item_title }}" class="form-control form-control-sm flex-grow-1">
                              <input type="text" name="theme_termopab_menu_column{{ col }}[{{ idx }}][href][{{ lang.language_id }}]" value="{{ item.href is iterable and item.href[lang.language_id] is defined ? item.href[lang.language_id] : item.href|default('') }}" placeholder="{{ entry_menu_item_url }}" class="form-control form-control-sm flex-grow-1">
                            </div>
                            {% endfor %}
                          </div>
                          <div class="col-md-2 d-flex gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm menu-item-up" title="{{ button_up }}"><i class="fa-solid fa-arrow-up"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm menu-item-down" title="{{ button_down }}"><i class="fa-solid fa-arrow-down"></i></button>
                            <button type="button" class="btn btn-outline-danger btn-sm menu-item-remove" title="{{ button_remove }}"><i class="fa-solid fa-minus"></i></button>
                          </div>
                        </div>
                      </div>
                      {% else %}
                      <div class="text-muted">{{ text_menu_empty }}</div>
                      {% endfor %}
                    </div>
                    <button type="button" class="menu-column-add btn btn-outline-primary btn-sm mt-2" data-column="{{ col }}"><i class="fa-solid fa-plus"></i> {{ button_add }}</button>
                  </div>
                </div>
                {% endfor %}
              </fieldset>
            </div>
            <div id="tab-footer" class="tab-pane">
              <fieldset>
                <legend>{{ tab_footer }}</legend>
                <div class="row mb-4">
                  <label class="col-sm-2 col-form-label">{{ entry_footer_socials }}</label>
                  <div class="col-sm-10">
                    <div class="form-text mb-2">{{ help_footer_socials }}</div>
                    <div class="d-flex flex-wrap gap-3">
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_footer_social_instagram" value="1" id="footer-social-instagram" class="form-check-input"{% if theme_termopab_footer_social_instagram %} checked{% endif %}>
                        <label for="footer-social-instagram" class="form-check-label">{{ entry_social_instagram }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_footer_social_whatsapp" value="1" id="footer-social-whatsapp" class="form-check-input"{% if theme_termopab_footer_social_whatsapp %} checked{% endif %}>
                        <label for="footer-social-whatsapp" class="form-check-label">{{ entry_social_whatsapp }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_footer_social_telegram" value="1" id="footer-social-telegram" class="form-check-input"{% if theme_termopab_footer_social_telegram %} checked{% endif %}>
                        <label for="footer-social-telegram" class="form-check-label">{{ entry_social_telegram }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_footer_social_facebook" value="1" id="footer-social-facebook" class="form-check-input"{% if theme_termopab_footer_social_facebook %} checked{% endif %}>
                        <label for="footer-social-facebook" class="form-check-label">{{ entry_social_facebook }}</label>
                      </div>
                      <div class="form-check">
                        <input type="checkbox" name="theme_termopab_footer_social_youtube" value="1" id="footer-social-youtube" class="form-check-input"{% if theme_termopab_footer_social_youtube %} checked{% endif %}>
                        <label for="footer-social-youtube" class="form-check-label">{{ entry_social_youtube }}</label>
                      </div>
                    </div>
                  </div>
                </div>
                <hr class="my-4">
                <ul class="nav nav-tabs">
                  {% for language in languages %}
                    <li class="nav-item"><a href="#language-footer-{{ language.language_id }}" data-bs-toggle="tab" class="nav-link{% if loop.first %} active{% endif %}"><img src="{{ language.image }}" title="{{ language.name }}"/> {{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content mt-3">
                  {% for language in languages %}
                    <div id="language-footer-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                      <div class="row mb-3">
                        <label for="input-address-{{ language.language_id }}" class="col-sm-2 col-form-label">{{ entry_address }}</label>
                        <div class="col-sm-10">
                          <textarea name="theme_termopab_address[{{ language.language_id }}]" rows="3" placeholder="{{ entry_address }}" id="input-address-{{ language.language_id }}" class="form-control">{{ theme_termopab_address[language.language_id] ?? '' }}</textarea>
                        </div>
                      </div>
                      <div class="row mb-3">
                        <label for="input-worknote-{{ language.language_id }}" class="col-sm-2 col-form-label">{{ entry_worknote }}</label>
                        <div class="col-sm-10">
                          <input type="text" name="theme_termopab_worknote[{{ language.language_id }}]" value="{{ theme_termopab_worknote[language.language_id] ?? '' }}" placeholder="{{ entry_worknote }}" id="input-worknote-{{ language.language_id }}" class="form-control"/>
                        </div>
                      </div>
                      <div class="row mb-3">
                        <label for="input-schedule-{{ language.language_id }}" class="col-sm-2 col-form-label">{{ entry_schedule }}</label>
                        <div class="col-sm-10">
                          <textarea name="theme_termopab_schedule[{{ language.language_id }}]" rows="4" placeholder="{{ entry_schedule }}" id="input-schedule-{{ language.language_id }}" class="form-control">{{ theme_termopab_schedule[language.language_id] ?? '' }}</textarea>
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
                <hr class="my-4">
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_footer_menu }}</label>
                  <div class="col-sm-10 d-flex flex-column gap-1">
                    <div class="form-check">
                      <input type="radio" name="theme_termopab_footer_menu_use_main" value="1" id="footer-menu-use-main" class="form-check-input"{% if footer_menu_use_main %} checked{% endif %}>
                      <label for="footer-menu-use-main" class="form-check-label">{{ entry_footer_menu_use_main }}</label>
                    </div>
                    <div class="form-check">
                      <input type="radio" name="theme_termopab_footer_menu_use_main" value="0" id="footer-menu-configure" class="form-check-input"{% if not footer_menu_use_main %} checked{% endif %}>
                      <label for="footer-menu-configure" class="form-check-label">{{ entry_footer_menu_configure }}</label>
                    </div>
                  </div>
                </div>
                <div id="footer-menu-items-wrap" class="row mb-3 {{ footer_menu_use_main ? 'd-none' : '' }}">
                  <label class="col-sm-2 col-form-label">{{ entry_footer_menu_items }}</label>
                  <div class="col-sm-10">
                    <div id="footer-menu-items" class="list-group">
                      {% for idx, item in footer_menu_items %}
                      <div class="list-group-item menu-item-row" data-type="{{ item.type|default('category') }}">
                        <div class="row align-items-center">
                          <div class="col-md-2">
                            <select name="theme_termopab_footer_menu[{{ idx }}][type]" class="form-select form-select-sm menu-item-type">
                              <option value="category"{% if (item.type|default('category')) == 'category' %} selected{% endif %}>{{ entry_menu_item_category }}</option>
                              <option value="information"{% if (item.type|default('')) == 'information' %} selected{% endif %}>{{ entry_menu_item_information }}</option>
                              <option value="custom"{% if (item.type|default('')) == 'custom' %} selected{% endif %}>{{ entry_menu_item_custom }}</option>
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-information {{ (item.type|default('category')) != 'information' ? 'd-none' : '' }}">
                            <select name="theme_termopab_footer_menu[{{ idx }}][information_id]" class="form-select form-select-sm">
                              <option value="">{{ text_select }}</option>
                              {% for info in informations %}
                              <option value="{{ info.information_id }}"{% if (item.information_id|default(0)) == info.information_id %} selected{% endif %}>{{ info.title }}</option>
                              {% endfor %}
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-category {{ (item.type|default('category')) != 'category' ? 'd-none' : '' }}">
                            <select name="theme_termopab_footer_menu[{{ idx }}][category_id]" class="form-select form-select-sm">
                              <option value="">{{ text_select }}</option>
                              {% for cat in categories_flat %}
                              <option value="{{ cat.category_id }}"{% if (item.category_id|default(0)) == cat.category_id %} selected{% endif %}>{{ cat.name }}</option>
                              {% endfor %}
                            </select>
                          </div>
                          <div class="col-md-4 menu-field-custom {{ (item.type|default('category')) != 'custom' ? 'd-none' : '' }}">
                            {% for lang in languages %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                              <img src="{{ lang.image }}" alt="" width="20" height="14" class="rounded flex-shrink-0">
                              <input type="text" name="theme_termopab_footer_menu[{{ idx }}][title][{{ lang.language_id }}]" value="{{ item.title[lang.language_id]|default('') }}" placeholder="{{ entry_menu_item_title }}" class="form-control form-control-sm flex-grow-1">
                              <input type="text" name="theme_termopab_footer_menu[{{ idx }}][href][{{ lang.language_id }}]" value="{{ item.href is iterable and item.href[lang.language_id] is defined ? item.href[lang.language_id] : item.href|default('') }}" placeholder="{{ entry_menu_item_url }}" class="form-control form-control-sm flex-grow-1">
                            </div>
                            {% endfor %}
                          </div>
                          <div class="col-md-2 d-flex gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm menu-item-up" title="{{ button_up }}"><i class="fa-solid fa-arrow-up"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm menu-item-down" title="{{ button_down }}"><i class="fa-solid fa-arrow-down"></i></button>
                            <button type="button" class="btn btn-outline-danger btn-sm menu-item-remove" title="{{ button_remove }}"><i class="fa-solid fa-minus"></i></button>
                          </div>
                        </div>
                      </div>
                      {% else %}
                      <div class="text-muted">{{ text_menu_empty }}</div>
                      {% endfor %}
                    </div>
