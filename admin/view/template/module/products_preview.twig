{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_items }}</label>
            <div class="col-sm-10">
              <div id="products-preview-items" class="border rounded p-3 bg-light">
                {% for item in items %}
                  <div class="products-preview-row card mb-3" data-row="{{ item.row }}">
                    <div class="card-body">
                      <div class="row mb-2">
                        <div class="col-md-6">
                          <label class="form-label">{{ entry_product }}</label>
                          <input type="text" class="form-control item-product-name" value="{{ item.product_name }}" placeholder="{{ entry_product }}" readonly/>
                          <input type="hidden" name="item[{{ item.row }}][product_id]" value="{{ item.product_id }}" class="item-product-id"/>
                        </div>
                        <div class="col-md-6 text-end">
                          <button type="button" class="btn btn-danger btn-remove-item mt-4"><i class="fa-solid fa-trash"></i></button>
                        </div>
                      </div>
                      <div class="row mb-2">
                        <div class="col-12">
                          <label class="form-label">{{ entry_attribute }}</label>
                          <select name="item[{{ item.row }}][attribute][]" class="form-select item-attributes" multiple size="4">
                            {% for attr in item.attribute_options %}
                              <option value="{{ attr.attribute_id }}"{% if attr.selected %} selected{% endif %}>{{ attr.name }}</option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="row mb-2">
                        <div class="col-12">
                          <label class="form-label">{{ entry_description }}</label>
                          {{ item.description_html|raw }}
                        </div>
                      </div>
                    </div>
                  </div>
                {% else %}
                  <p class="text-muted mb-0">{{ text_no_items }}</p>
                {% endfor %}
              </div>
              <div class="mt-2">
                <button type="button" id="btn-add-item" class="btn btn-success"><i class="fa-solid fa-plus"></i> {{ button_add }}</button>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-width" class="col-sm-2 col-form-label">{{ entry_image_width }}</label>
            <div class="col-sm-10">
              <input type="number" name="width" value="{{ width }}" placeholder="{{ entry_image_width }}" id="input-width" class="form-control" min="1"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-height" class="col-sm-2 col-form-label">{{ entry_image_height }}</label>
            <div class="col-sm-10">
              <input type="number" name="height" value="{{ height }}" placeholder="{{ entry_image_height }}" id="input-height" class="form-control" min="1"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>

<template id="products-preview-description-template">
  <div class="row mb-2">
    <div class="col-12">
      <label class="form-label">{{ entry_description }}</label>
      {{ description_template_html|raw }}
    </div>
  </div>
</template>

<script type="text/javascript"><!--
var productsPreviewRow = {{ next_row }};
var productsPreviewAttributesUrl = '{{ attributes_url|e('js') }}';
var productsPreviewAutocompleteUrl = '{{ product_autocomplete_url|e('js') }}';
var productsPreviewInitialUrl = '{{ product_initial_url|e('js') }}';
var productsPreviewSearchTimer = null;

function getNewRowHtml(rowIdx) {
  var html = '<div class="products-preview-row card mb-3" data-row="' + rowIdx + '">';
  html += '<div class="card-body">';
  html += '<div class="row mb-2">';
  html += '<div class="col-md-6 position-relative">';
  html += '<label class="form-label">{{ entry_product|e('js') }}</label>';
  html += '<input type="text" class="form-control item-product-autocomplete" placeholder="{{ entry_product|e('js') }}" autocomplete="off"/>';
  html += '<input type="hidden" name="item[' + rowIdx + '][product_id]" value="" class="item-product-id"/>';
  html += '<ul class="item-product-dropdown dropdown-menu list-unstyled w-100 position-absolute" style="max-height: 200px; overflow-y: auto; z-index: 1050; display: none;"></ul>';
  html += '</div>';
  html += '<div class="col-md-6 text-end">';
  html += '<button type="button" class="btn btn-danger btn-remove-item mt-4"><i class="fa-solid fa-trash"></i></button>';
  html += '</div>';
  html += '</div>';
  html += '<div class="item-details" style="display:none;">';
  html += '<div class="row mb-2"><div class="col-12">';
  html += '<label class="form-label">{{ entry_attribute|e('js') }}</label>';
  html += '<select name="item[' + rowIdx + '][attribute][]" class="form-select item-attributes" multiple size="4"></select>';
  html += '</div></div>';
  var tpl = document.getElementById('products-preview-description-template');
  var descHtml = tpl ? tpl.innerHTML.replace(/__ROW__/g, rowIdx) : '';
  html += descHtml;
  html += '</div>';
  html += '</div></div>';
  return html;
}

$('#btn-add-item').on('click', function() {
  var html = getNewRowHtml(productsPreviewRow);
  if ($('#products-preview-items .products-preview-row').length === 0) {
    $('#products-preview-items').html(html);
  } else {
    $('#products-preview-items .products-preview-row:last').after(html);
  }
  productsPreviewRow++;
  initNewRowAutocomplete();
});

function fetchProductsAndShow($row, url) {
  var $menu = $row.find('.item-product-dropdown');
  $menu.empty().show().append('<li class="dropdown-item text-muted"><i class="fa-solid fa-circle-notch fa-spin"></i> {{ "Завантаження..."|e('js') }}</li>');
  $.ajax({
    url: url,
    dataType: 'json',
    success: function(json) {
      $menu.empty();
      if (json && json.length > 0) {
        $.each(json, function(i, item) {
          $menu.append('<li><a class="dropdown-item" href="#" data-id="' + item.product_id + '" data-name="' + (item.name || '').replace(/"/g, '&quot;') + '">' + (item.name || '') + '</a></li>');
        });
      } else {
        $menu.append('<li class="dropdown-item text-muted">{{ "Товарів не знайдено"|e('js') }}</li>');
      }
      $menu.css('display', 'block').show();
    },
    error: function() {
      $menu.empty().append('<li class="dropdown-item text-muted">{{ "Помилка завантаження"|e('js') }}</li>').show();
    }
  });
}

function initNewRowAutocomplete() {
  $('.item-product-autocomplete').off('input focus').on('input focus', function() {
    var $input = $(this);
    var $row = $input.closest('.products-preview-row');
    if ($row.data('product-selected')) return;

    if (productsPreviewSearchTimer) clearTimeout(productsPreviewSearchTimer);

    var filter = ($input.val() || '').trim();

    if (filter.length === 0) {
      fetchProductsAndShow($row, productsPreviewInitialUrl);
      return;
    }

    productsPreviewSearchTimer = setTimeout(function() {
      fetchProductsAndShow($row, productsPreviewAutocompleteUrl + '&filter_name=' + encodeURIComponent(filter));
    }, 250);
  });

  $('#products-preview-items').off('click', '.item-product-dropdown .dropdown-item').on('click', '.item-product-dropdown .dropdown-item', function(e) {
    e.preventDefault();
    e.stopPropagation();
    var $a = $(e.currentTarget);
    var productId = $a.data('id');
    var productName = $a.data('name');
    if (productId === undefined || productId === '') return;

    var $row = $a.closest('.products-preview-row');
    $row.find('.item-product-id').val(productId);
    $row.find('.item-product-autocomplete').val(productName).prop('readonly', true);
    $row.find('.item-product-dropdown').empty().hide();
    $row.data('product-selected', true);

    $row.find('.item-details').show();

    var attrsUrl = productsPreviewAttributesUrl + (productsPreviewAttributesUrl.indexOf('?') >= 0 ? '&' : '?') + 'product_id=' + productId;
    $.ajax({
      url: attrsUrl,
      dataType: 'json',
      success: function(json) {
        var $sel = $row.find('.item-attributes');
        $sel.empty();
        if (json && json.attributes) {
          $.each(json.attributes, function(i, attr) {
            $sel.append('<option value="' + attr.attribute_id + '">' + attr.name + '</option>');
          });
        }
      },
      error: function(xhr) {
        console.error('Products Preview: attributes load failed', xhr.status, xhr.responseText);
      }
    });
  });
}

$(document).on('click', function(e) {
  if ($(e.target).closest('.item-product-autocomplete, .item-product-dropdown').length) return;
  $('#products-preview-items .item-product-dropdown').empty().hide();
});

$('#products-preview-items').on('click', '.item-product-dropdown', function(e) {
  e.stopPropagation();
});

$('#products-preview-items').on('click', '.btn-remove-item', function(e) {
  e.preventDefault();
  $(this).closest('.products-preview-row').remove();
});

$('#form-module').on('submit', function() {
  var index = 0;
  $('#products-preview-items .products-preview-row').each(function() {
    var $row = $(this);
    $row.attr('data-row', index);
    $row.find('[name^="item["]').each(function() {
      var name = $(this).attr('name');
      name = name.replace(/item\[\d+\]/, 'item[' + index + ']');
      $(this).attr('name', name);
    });
    index++;
  });
});
//--></script>
{{ footer }}
