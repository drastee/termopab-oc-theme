{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_image_desktop }}</label>
            <div class="col-sm-10">
              <div class="border rounded d-inline-block mb-2" style="max-width: 300px;">
                <img src="{{ thumb_desktop }}" alt="" title="" id="thumb-desktop" data-oc-placeholder="{{ placeholder }}" class="img-fluid"/>
                <input type="hidden" name="image_desktop" value="{{ image_desktop }}" id="input-image-desktop"/>
                <div class="d-grid p-2">
                  <button type="button" data-oc-toggle="image" data-oc-target="#input-image-desktop" data-oc-thumb="#thumb-desktop" class="btn btn-primary rounded-0"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                  <button type="button" data-oc-toggle="clear" data-oc-target="#input-image-desktop" data-oc-thumb="#thumb-desktop" class="btn btn-warning rounded-0"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                </div>
              </div>
              <div class="form-text">{{ help_image_desktop }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_image_mobile }}</label>
            <div class="col-sm-10">
              <div class="border rounded d-inline-block mb-2" style="max-width: 300px;">
                <img src="{{ thumb_mobile }}" alt="" title="" id="thumb-mobile" data-oc-placeholder="{{ placeholder }}" class="img-fluid"/>
                <input type="hidden" name="image_mobile" value="{{ image_mobile }}" id="input-image-mobile"/>
                <div class="d-grid p-2">
                  <button type="button" data-oc-toggle="image" data-oc-target="#input-image-mobile" data-oc-thumb="#thumb-mobile" class="btn btn-primary rounded-0"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                  <button type="button" data-oc-toggle="clear" data-oc-target="#input-image-mobile" data-oc-thumb="#thumb-mobile" class="btn btn-warning rounded-0"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                </div>
              </div>
              <div class="form-text">{{ help_image_mobile }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">
              <ul class="nav nav-tabs" role="tablist">
                {% for language in languages %}
                  <li class="nav-item">
                    <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#tab-title-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content mt-2">
                {% for language in languages %}
                  <div id="tab-title-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                    <input type="text" name="title[{{ language.language_id }}]" value="{{ (title[language.language_id] ?? '') }}" class="form-control" placeholder="{{ entry_title_placeholder }}"/>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_subtitle }}</label>
            <div class="col-sm-10">
              <ul class="nav nav-tabs" role="tablist">
                {% for language in languages %}
                  <li class="nav-item">
                    <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#tab-subtitle-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content mt-2">
                {% for language in languages %}
                  <div id="tab-subtitle-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                    <input type="text" name="subtitle[{{ language.language_id }}]" value="{{ (subtitle[language.language_id] ?? '') }}" class="form-control" placeholder="{{ entry_subtitle_placeholder }}"/>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-height-mode" class="col-sm-2 col-form-label">{{ entry_height_mode }}</label>
            <div class="col-sm-10">
              <select name="height_mode" id="input-height-mode" class="form-select">
                <option value="default"{% if height_mode == 'default' %} selected{% endif %}>{{ text_height_default }}</option>
                <option value="large"{% if height_mode == 'large' %} selected{% endif %}>{{ text_height_large }}</option>
              </select>
              <div class="form-text">{{ help_height_mode }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-custom-class" class="col-sm-2 col-form-label">{{ entry_custom_class }}</label>
            <div class="col-sm-10">
              <input type="text" name="custom_class" value="{{ custom_class }}" placeholder="{{ entry_custom_class_placeholder }}" id="input-custom-class" class="form-control"/>
              <div class="form-text">{{ help_custom_class }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
