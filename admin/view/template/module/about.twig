{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_content }}</label>
            <div class="col-sm-10">
              <ul class="nav nav-tabs" role="tablist">
                {% for language in languages %}
                  <li class="nav-item">
                    <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#tab-lang-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content mt-2">
                {% for language in languages %}
                  <div id="tab-lang-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                    <div class="mb-3">
                      <label class="form-label">{{ entry_title_lines }}</label>
                      <textarea name="title_lines[{{ language.language_id }}]" class="form-control" rows="4" placeholder="{{ help_title_lines }}">{{ (title_lines[language.language_id] ?? [])|join("\n") }}</textarea>
                      <div class="form-text">{{ help_title_lines }}</div>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">{{ entry_description }}</label>
                      <textarea name="description[{{ language.language_id }}]" class="form-control" rows="5" placeholder="{{ entry_description }}">{{ (description[language.language_id] ?? '') }}</textarea>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">{{ entry_button_text }}</label>
                      <input type="text" name="button_text[{{ language.language_id }}]" value="{{ (button_text[language.language_id] ?? '') }}" class="form-control" placeholder="{{ entry_button_text }}"/>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-button-url" class="col-sm-2 col-form-label">{{ entry_button_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="button_url" value="{{ button_url }}" placeholder="{{ entry_button_url }}" id="input-button-url" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_facts }}</label>
            <div class="col-sm-10">
              <div id="about-facts-list" class="border rounded p-3 bg-light">
                {% for fact in facts %}
                  <div class="about-fact-row card mb-3" data-row="{{ loop.index0 }}">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>{{ entry_fact }} #{{ loop.index }}</strong>
                        <button type="button" class="btn btn-danger btn-sm btn-remove-fact"><i class="fa-solid fa-trash"></i></button>
                      </div>
                      <ul class="nav nav-tabs" role="tablist">
                        {% for language in languages %}
                          <li class="nav-item">
                            <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#fact-{{ loop.parent.loop.index0 }}-lang-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                      <div class="tab-content mt-2">
                        {% for language in languages %}
                          <div id="fact-{{ loop.parent.loop.index0 }}-lang-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                            <div class="mb-2">
                              <label class="form-label small">{{ entry_fact_title }}</label>
                              <input type="text" name="fact[{{ loop.parent.loop.index0 }}][title][{{ language.language_id }}]" value="{{ (fact.title[language.language_id] ?? '') }}" class="form-control form-control-sm"/>
                            </div>
                            <div class="mb-2">
                              <label class="form-label small">{{ entry_fact_text }}</label>
                              <textarea name="fact[{{ loop.parent.loop.index0 }}][text][{{ language.language_id }}]" class="form-control form-control-sm" rows="2">{{ (fact.text[language.language_id] ?? '') }}</textarea>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                      <div class="mt-2">
                        <label class="form-label small">{{ entry_fact_url }}</label>
                        <input type="text" name="fact[{{ loop.index0 }}][url]" value="{{ (fact.url ?? '#') }}" class="form-control form-control-sm" placeholder="#"/>
                      </div>
                    </div>
                  </div>
                {% else %}
                  <p class="text-muted mb-0">{{ text_no_facts }}</p>
                {% endfor %}
              </div>
              <div class="mt-2">
                <button type="button" id="btn-add-fact" class="btn btn-success"><i class="fa-solid fa-plus"></i> {{ button_add_fact }}</button>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>

<template id="about-fact-template">
  <div class="about-fact-row card mb-3" data-row="__ROW__">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <strong>{{ entry_fact }} #<span class="fact-num">__ROW__</span></strong>
        <button type="button" class="btn btn-danger btn-sm btn-remove-fact"><i class="fa-solid fa-trash"></i></button>
      </div>
      <ul class="nav nav-tabs" role="tablist">
        {% for language in languages %}
          <li class="nav-item">
            <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#fact-__ROW__-lang-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
          </li>
        {% endfor %}
      </ul>
      <div class="tab-content mt-2">
        {% for language in languages %}
          <div id="fact-__ROW__-lang-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
            <div class="mb-2">
              <label class="form-label small">{{ entry_fact_title }}</label>
              <input type="text" name="fact[__ROW__][title][{{ language.language_id }}]" value="" class="form-control form-control-sm"/>
            </div>
            <div class="mb-2">
              <label class="form-label small">{{ entry_fact_text }}</label>
              <textarea name="fact[__ROW__][text][{{ language.language_id }}]" class="form-control form-control-sm" rows="2"></textarea>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="mt-2">
        <label class="form-label small">{{ entry_fact_url }}</label>
        <input type="text" name="fact[__ROW__][url]" value="#" class="form-control form-control-sm" placeholder="#"/>
      </div>
    </div>
  </div>
</template>

<script type="text/javascript"><!--
var aboutFactNextRow = {{ facts|length }};

document.getElementById('btn-add-fact')?.addEventListener('click', function() {
  var tpl = document.getElementById('about-fact-template');
  if (!tpl) return;
  var html = tpl.innerHTML.replace(/__ROW__/g, aboutFactNextRow);
  var wrap = document.createElement('div');
  wrap.innerHTML = html;
  var first = wrap.firstElementChild;
  if (!first) return;

  var container = document.getElementById('about-facts-list');
  var noItems = container.querySelector('.text-muted');
  if (noItems) noItems.remove();
  container.appendChild(first);
  var numEl = first.querySelector('.fact-num');
  if (numEl) numEl.textContent = aboutFactNextRow + 1;
  aboutFactNextRow++;
});

document.getElementById('about-facts-list')?.addEventListener('click', function(e) {
  var btn = e.target.closest('.btn-remove-fact');
  if (!btn) return;
  e.preventDefault();
  var row = btn.closest('.about-fact-row');
  if (row) row.remove();
});
//--></script>
{{ footer }}
