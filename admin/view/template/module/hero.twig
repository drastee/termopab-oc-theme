{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-video" class="col-sm-2 col-form-label">{{ entry_video }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="video" value="{{ video }}" placeholder="catalog/hero/hero.mp4" id="input-video" class="form-control"/>
                <input type="file" id="input-video-file" accept="video/mp4,.mp4" class="d-none"/>
                <button type="button" id="btn-upload-video" class="btn btn-primary"><i class="fa-solid fa-upload"></i> {{ button_upload }}</button>
              </div>
              <div id="hero-video-error" class="invalid-feedback d-none"></div>
              <div class="form-text">{{ help_video }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-poster" class="col-sm-2 col-form-label">{{ entry_poster }}</label>
            <div class="col-sm-10">
              <div class="border rounded d-block mb-2" style="max-width: 300px;">
                <img src="{{ poster_thumb }}" alt="" title="" id="thumb-poster" data-oc-placeholder="{{ placeholder }}" class="img-fluid"/>
                <input type="hidden" name="poster" value="{{ poster }}" id="input-poster"/>
                <div class="d-grid p-2">
                  <button type="button" data-oc-toggle="image" data-oc-target="#input-poster" data-oc-thumb="#thumb-poster" class="btn btn-primary rounded-0"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                  <button type="button" data-oc-toggle="clear" data-oc-target="#input-poster" data-oc-thumb="#thumb-poster" class="btn btn-warning rounded-0"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                </div>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_title_lines }}</label>
            <div class="col-sm-10">
              <div class="alert alert-info">
                {{ help_title_lines }}
              </div>
              <ul class="nav nav-tabs" role="tablist">
                {% for language in languages %}
                  <li class="nav-item">
                    <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#tab-lang-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}" class="me-1"/>{% endif %}{{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content mt-2">
                {% for language in languages %}
                  <div id="tab-lang-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                    <textarea name="title_lines[{{ language.language_id }}]" class="form-control" rows="4" placeholder="{{ entry_title_lines }}">{{ (title_lines[language.language_id] ?? [])|join("\n") }}</textarea>
                    <div class="form-text">{{ help_title_lines_lang }}</div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('btn-upload-video')?.addEventListener('click', function() {
    document.getElementById('input-video-file')?.click();
  });

  document.getElementById('input-video-file')?.addEventListener('change', function() {
    var fileInput = this;
    var file = fileInput.files[0];
    if (!file) return;

    var fd = new FormData();
    fd.append('video', file);

    var btn = document.getElementById('btn-upload-video');
    var err = document.getElementById('hero-video-error');
    var input = document.getElementById('input-video');
    if (btn) btn.disabled = true;
    if (err) { err.classList.add('d-none'); err.textContent = ''; }

    fetch('index.php?route=extension/termopab/module/hero.upload&user_token={{ user_token }}', {
      method: 'POST',
      body: fd
    })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function(json) {
      if (json.error) {
        if (err) { err.textContent = json.error; err.classList.remove('d-none'); }
      }
      if (json.path && input) {
        input.value = json.path;
        if (err) err.classList.add('d-none');
        alert(json.success || 'Відео завантажено! Натисніть «Зберегти» щоб зберегти зміни.');
      }
    })
    .catch(function(e) {
      if (err) { err.textContent = 'Помилка: ' + (e.message || 'невідома помилка'); err.classList.remove('d-none'); }
    })
    .finally(function() {
      if (btn) btn.disabled = false;
      fileInput.value = '';
    });
  });
});
//--></script>
{{ footer }}
