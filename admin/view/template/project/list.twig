{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        {% if show_install %}
          <a href="{{ install }}" class="btn btn-secondary"><i class="fa-solid fa-database"></i> {{ button_install }}</a>
        {% endif %}
        <a href="{{ add }}" class="btn btn-primary"><i class="fa-solid fa-plus"></i> {{ button_add }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-exclamation-triangle"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
      <div class="card-body">
        {% if projects is empty %}
          <p class="text-muted mb-0">{{ text_no_results }}</p>
        {% else %}
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-center" style="width: 50px;">{{ column_id }}</td>
                  <td class="text-center">{{ column_image }}</td>
                  <td>{{ column_title }}</td>
                  <td class="text-center">{{ column_sort_order }}</td>
                  <td class="text-center">{{ column_status }}</td>
                  <td class="text-end">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% for project in projects %}
                  <tr>
                    <td class="text-center">{{ project.project_id }}</td>
                    <td class="text-center"><img src="{{ project.image }}" alt="" class="img-thumbnail"/></td>
                    <td>{{ project.title }}</td>
                    <td class="text-center">{{ project.sort_order }}</td>
                    <td class="text-center">{% if project.status %}<span class="badge bg-success">ON</span>{% else %}<span class="badge bg-secondary">OFF</span>{% endif %}</td>
                    <td class="text-end">
                      <a href="{{ project.edit }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</a>
                      <a href="{{ project.delete }}" class="btn btn-danger btn-sm" onclick="return confirm('Delete this project?');"><i class="fa-solid fa-trash"></i> {{ button_delete }}</a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="row">
            <div class="col-sm-6 text-start"></div>
            <div class="col-sm-6 text-end">{{ pagination }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
