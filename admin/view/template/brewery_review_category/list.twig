{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ add }}" class="btn btn-primary"><i class="fa-solid fa-plus"></i> {{ button_add }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-exclamation-triangle"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
      <div class="card-body">
        {% if categories is empty %}
          <p class="text-muted mb-0">{{ text_no_results }}</p>
        {% else %}
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-center" style="width: 60px;">{{ column_id }}</td>
                  <td>{{ column_title }}</td>
                  <td class="text-center">{{ column_sort_order }}</td>
                  <td class="text-center">{{ column_status }}</td>
                  <td class="text-end">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% for category in categories %}
                  <tr>
                    <td class="text-center">{{ category.brewery_review_category_id }}</td>
                    <td>{{ category.title }}</td>
                    <td class="text-center">{{ category.sort_order }}</td>
                    <td class="text-center">{% if category.status %}<span class="badge bg-success">ON</span>{% else %}<span class="badge bg-secondary">OFF</span>{% endif %}</td>
                    <td class="text-end">
                      <a href="{{ category.edit }}" class="btn btn-primary btn-sm" title="{{ button_edit }}"><i class="fa-solid fa-pencil"></i></a>
                      <a href="{{ category.delete }}" class="btn btn-danger btn-sm" title="{{ button_delete }}" onclick="return confirm('{{ text_confirm_delete }}');"><i class="fa-solid fa-trash"></i></a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
