{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-category" class="btn btn-primary"><i class="fa-solid fa-save"></i> {{ button_save }}</button>
        <a href="{{ cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}<div class="alert alert-success alert-dismissible">{{ success }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger alert-dismissible">{{ error_warning }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-category" action="{{ save }}" method="post">
          <input type="hidden" name="brewery_review_category_id" value="{{ brewery_review_category_id }}"/>
          <ul class="nav nav-tabs">
            {% for language in languages %}
              <li class="nav-item">
                <a class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" href="#lang-{{ language.language_id }}">{% if language.image %}<img src="{{ language.image }}" alt="" class="me-1"/>{% endif %}{{ language.name }}</a>
              </li>
            {% endfor %}
          </ul>
          <div class="tab-content mt-3">
            {% for language in languages %}
              <div id="lang-{{ language.language_id }}" class="tab-pane{% if loop.first %} active{% endif %}">
                <div class="row mb-3 required">
                  <label class="col-sm-2 col-form-label">{{ entry_title }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="category_description[{{ language.language_id }}][title]" value="{{ category_description[language.language_id].title }}" class="form-control" required/>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <hr/>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="sort_order" value="{{ sort_order }}" class="form-control" style="max-width: 100px;"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
