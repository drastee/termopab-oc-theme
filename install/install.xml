<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Termopab: Category hero image and breadcrumb</name>
  <version>1.0</version>
  <author>Termopab</author>
  <link></link>
  <file path="admin/view/template/catalog/category_form.twig">
    <operation>
      <search><![CDATA[                </table>
              </div>
            </div>
          </div>
          <input type="hidden" name="category_id"]]></search>
      <add position="replace"><![CDATA[                </table>
              </div>
              <div id="custom-fields-landing" class="mt-3" style="display:none;" data-layout-parent="{{ termopab_layout_parent_id|default(19) }}">
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">Фонове зображення шапки</label>
                  <div class="col-sm-10">
                    <div class="border rounded d-inline-block mb-2" style="max-width: 300px;">
                      <img src="{{ hero_thumb|default(hero_placeholder)|default('') }}" alt="" id="thumb-hero-image" data-oc-placeholder="{{ hero_placeholder|default('') }}" class="img-fluid"/>
                      <input type="hidden" name="hero_image" value="{{ hero_image|default('') }}" id="input-hero-image"/>
                      <div class="d-grid p-2">
                        <button type="button" data-oc-toggle="image" data-oc-target="#input-hero-image" data-oc-thumb="#thumb-hero-image" class="btn btn-primary rounded-0"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                        <button type="button" data-oc-toggle="clear" data-oc-target="#input-hero-image" data-oc-thumb="#thumb-hero-image" class="btn btn-warning rounded-0"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">Хлібні крихти</label>
                  <div class="col-sm-10">
                    <select name="breadcrumb_background" class="form-select">
                      <option value="black"{% if (breadcrumb_background|default('black')) == 'black' %} selected{% endif %}>Чорний фон</option>
                      <option value="white"{% if (breadcrumb_background|default('black')) == 'white' %} selected{% endif %}>Білий фон</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <input type="hidden" name="category_id"]]></add>
    </operation>
    <operation>
      <search><![CDATA[$('#category-filter').on('click', '.btn', function() {
    $(this).parent().parent().remove();
});
//--></script>]]></search>
      <add position="before"><![CDATA[
(function() {
  function toggleCustomFields() {
    var layoutSelect = document.querySelector('select[name="category_layout[0]"]');
    var landingEl = document.getElementById('custom-fields-landing');
    if (!layoutSelect || !landingEl) return;
    var layoutParentId = parseInt(landingEl.getAttribute('data-layout-parent') || '19', 10);
    var layoutId = parseInt(layoutSelect.value, 10) || 0;
    landingEl.style.display = layoutId === layoutParentId ? '' : 'none';
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', toggleCustomFields);
  } else {
    toggleCustomFields();
  }
  $(document).on('change', 'select[name="category_layout[0]"]', toggleCustomFields);
})();
]]></add>
    </operation>
  </file>
</modification>
