<div class="dropdown" data-type="select">
    <span class="dropdown__selected" aria-expanded="false">
        <span>{{ selected }}</span>
        <span class="dropdown__icon">
            <svg class="dropdown-arrow"><use href="#icon-dropdown-arrow"></use></svg>
        </span>
    </span>

    <div class="dropdown__menu" hidden>
        <ul class="dropdown__list">
            {% for option in options %}
            <li class="dropdown__item">
                {% if option.href is defined %}
                <a href="{{ option.href }}" class="dropdown-item dropdown__option">
                    <span>{{ option.label }}</span>
                </a>
                {% else %}
                <button type="button" class="dropdown__option" data-value="{{ option is iterable ? (option.value ?? option.label) : option }}">
                    <span>{{ option is iterable ? option.label : option }}</span>
                </button>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
