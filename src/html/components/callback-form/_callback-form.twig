<form class="callback-form {{type ?? ''}}" action="" id="">

    <label class="label" for="telephone">Ваше імʼя</label>
    <input id="name" name="name" type="text" placeholder="Імʼя">

    <label class="label" for="phone">Ваш телефон</label>
    <input id="phone" name="phone" type="text" placeholder="+_ (___) ___-__-__">
    
    <button type="submit" class="btn btn-primary">
        Отримати консультацію
        <svg class="icon-arrow"><use href="#icon-short-arrow"></use></svg>
    </button>

    <p class="agreement">Натискаючи на кнопку, ви даєте згоду на обробку своїх персональних даних і погоджуєтеся з <a href="#">Політикою конфіденційності</a></p>

</form>