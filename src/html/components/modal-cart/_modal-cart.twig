<dialog id="order-modal" class="modal-cart">
    <div class="modal-cart__container">
        <h2 class="modal-cart__title section-title">Оформлення замовлення</h2>
        <form class="modal-cart__inner" action="#">
            <div>
                <div class="fields-wrapper">
                    <label class="label" for="telephone">Введіть імʼя</label>
                    <input id="name" name="name" type="text" placeholder="ПІБ">
                </div>

                <div class="fields-wrapper">
                    <label class="label" for="phone">Ваш телефон</label>
                    <input id="phone" name="phone" type="tel" placeholder="+_ (___) ___-__-__">
                </div>


                <div class="fields-wrapper">
                    <label class="label" for="email">Введіть ваш E-Mail</label>
                    <input id="email" name="email" type="email" placeholder="E-Mail">
                </div>

                <div class="fields-wrapper">
                    <label class="label">Доставка новою поштою</label>
                    <input id="city" name="name" type="text" placeholder="Введіть місто">
                    <input id="office" name="name" type="text" placeholder="Введіть відділення">
                </div>

                <div class="fields-wrapper">
                    <span class="label">Оберіть спосіб оплати</span>
                    <label class="radio-label">
                        <input type="radio" name="payment_method" value="cashless" checked>
                        <span class="radio-text">Безготівковий розрахунок для юридичних осіб</span>
                    </label>

                    <label class="radio-label">
                        <input type="radio" name="payment_method" value="cash">
                        <span class="radio-text">Розрахунок готівкою при отриманні товару</span>
                    </label>
                </div>
            </div>
            <div>
                <div class="cart-product">
                    <div class="cart-product__image">
                        <img src="/src/assets/images/thumb.webp" class="img-base" alt="">
                    </div>
                    <div class="cart-product__info">
                        <h3 class="cart-product__title">Форфас горизонтальний на 1000 л - CIP</h3>
                        <p class="cart-product__price">€31 495</p>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    Отримати консультацію
                    <svg class="icon-arrow"><use href="#icon-short-arrow"></use></svg>
                </button>
                <hr class="custom">
                <div class="agreement">
                    <input type="checkbox" id="agreement" name="agreement" />
                    <label for="agreement">Натискаючи на кнопку, ви даєте згоду на обробку своїх персональних даних і погоджуєтеся з <a href="#">Політикою конфіденційності</a></label>
                </div>
            </div>
        </form>

    </div>
</dialog>