<dialog id="order-modal" class="modal-cart">
    <div class="modal-cart__container">
        <h2 class="modal-cart__title section-title">{{ modal_cart_title }}</h2>
        <form class="modal-cart__inner" action="#" id="modal-cart-form">
            <div>
                <div class="fields-wrapper">
                    <label class="label" for="modal-cart-name">{{ modal_cart_label_name }}</label>
                    <input id="modal-cart-name" name="name" type="text" placeholder="{{ modal_cart_placeholder_name }}">
                    <span class="modal-cart__error" id="modal-cart-error-name" aria-live="polite"></span>
                </div>

                <div class="fields-wrapper">
                    <label class="label" for="modal-cart-phone">{{ modal_cart_label_phone }}</label>
                    <input id="modal-cart-phone" name="phone" type="tel" placeholder="{{ modal_cart_placeholder_phone }}">
                    <span class="modal-cart__error" id="modal-cart-error-phone" aria-live="polite"></span>
                </div>

                <div class="fields-wrapper">
                    <label class="label" for="modal-cart-email">{{ modal_cart_label_email }}</label>
                    <input id="modal-cart-email" name="email" type="email" placeholder="{{ modal_cart_placeholder_email }}">
                    <span class="modal-cart__error" id="modal-cart-error-email" aria-live="polite"></span>
                </div>

                <div class="fields-wrapper">
                    <label class="label" for="modal-cart-city">{{ modal_cart_label_delivery }}</label>
                    <input id="modal-cart-city" name="city" type="text" placeholder="{{ modal_cart_placeholder_city }}">
                    <input id="modal-cart-office" name="office" type="text" placeholder="{{ modal_cart_placeholder_office }}">
                </div>

                {% if modal_cart_payment_methods|default([])|length > 0 %}
                    <div class="fields-wrapper">
                        <span class="label">{{ modal_cart_label_payment }}</span>
                        {% for pm in modal_cart_payment_methods %}
                            <label class="radio-label">
                                <input type="radio" name="payment_method" value="{{ pm.code }}"{{ loop.first ? ' checked' : '' }}>
                                <span class="radio-text">{{ pm.name }}</span>
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div>
                <div class="cart-product" id="modal-cart-product">
                    <div class="cart-product__image">
                        <img id="modal-cart-product-img" src="" class="img-base" alt="" style="display: none;">
                    </div>
                    <div class="cart-product__info">
                        <h3 class="cart-product__title" id="modal-cart-product-title"></h3>
                        <p class="cart-product__price" id="modal-cart-product-price"></p>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    {{ modal_cart_button }}
                    <svg class="icon-arrow"><use href="#icon-short-arrow"></use></svg>
                </button>
                <hr class="custom">
                <div class="agreement">
                    <input type="checkbox" id="modal-cart-agreement" name="agreement">
                    <label for="modal-cart-agreement">{{ modal_cart_agreement|raw }}<br><span class="modal-cart__error" id="modal-cart-error-agreement" aria-live="polite"></span></label>
                </div>
                
            </div>
        </form>

    </div>
</dialog>
