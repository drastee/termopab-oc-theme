<div class="phones-styled">
    {% for phone in telephones|default([]) %}
    <a href="tel:{{ phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ phone }}</a>
    {% else %}
    {% if telephone|default('') %}
    <a href="tel:{{ telephone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ telephone }}</a>
    {% endif %}
    {% endfor %}
</div>
