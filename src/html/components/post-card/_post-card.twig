<a href="{{ href|default('#') }}" class="post-card">
    
    <div class="post-card__image">
        <img src="{{ image }}" alt="{{ title }}">
    </div>
    
    <div class="post-card__inner">
        <p class="post-card__title">{{ title }}</p>
        <p class="post-card__description">{{ description }}</p>
    </div>

</a>