{% set menu_cols = menu_columns|default({}) %}
{% set col1 = menu_cols[1]|default([]) %}
{% set col2 = menu_cols[2]|default([]) %}
{% set col3 = menu_cols[3]|default([]) %}
{% set default_image = (col1|length > 0 and col1[0].image) ? col1[0].image : (base is defined and base ? base ~ 'extension/termopab/catalog/view/image/product-bg.webp' : '/src/assets/images/gallery/2.webp') %}
<nav id="mobile-menu" class="nav" hidden>
    <div class="main-wrapper">
        <div class="container-full-left nav__wrapper">
                <div class="nav__image">
                    <img class="nav-img active" src="{{ default_image }}" alt="">
                    <img class="nav-img next" src="" alt="">
                </div>
                <div class="nav__columns">
                    <ul class="nav__list">
                        {% for item in col1 %}
                        <li>
                            {% if item.children|length > 0 %}
                            <a href="{{ item.href }}" class="nav__parent-link"{% if item.image %} data-image="{{ item.image }}"{% endif %}>{{ item.name }}</a>
                            <ul class="nav__submenu" hidden>
                                {% for child in item.children %}
                                <li><a href="{{ child.href }}">{{ child.name }}</a></li>
                                {% endfor %}
                            </ul>
                            {% else %}
                            <a href="{{ item.href }}"{% if item.image %} data-image="{{ item.image }}"{% endif %}>{{ item.name }}</a>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>

                    <ul class="nav__list">
                        {% for item in col2 %}
                        <li>
                            <a href="{{ item.href }}"{% if item.image %} data-image="{{ item.image }}"{% endif %}>{{ item.name }}</a>
                        </li>
                        {% endfor %}
                    </ul>

                    <ul class="nav__list">
                        {% for item in col3 %}
                        <li>
                            <a href="{{ item.href }}"{% if item.image %} data-image="{{ item.image }}"{% endif %}>{{ item.name }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
        </div>
    </div>
</nav>
