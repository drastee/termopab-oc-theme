<div class="gallery-grid">
    {% for image in images %}
        {% set href = image.href is defined ? image.href : image %}
        {% set src = image.src is defined ? image.src : image %}
        <a href="{{ href }}" class="gallery-grid__item" data-fancybox="gallery">
            <img src="{{ src }}" alt="Фото проєкту {{ loop.index }}" loading="lazy">
            <span class="gallery-grid__overlay"></span>
        </a>
    {% endfor %}
</div>