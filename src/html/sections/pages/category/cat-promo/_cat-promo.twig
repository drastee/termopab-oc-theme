<section class="cat-promo {{type}}">
    <div class="container">
        <h2 class="title-secondary">{{title}}</h2>
        <div class="cat-promo__grid">
            <div class="cat-promo__buttons">
                <a class="link" href="#">Детальніше <svg class="link-arrow"><use href="#icon-short-arrow"></use></svg></a>
            </div>
            <div class="cat-promo__content">
                <div class="cat-promo__description">
                    <p>
                        {{description}}
                    </p>
                    <p><b>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</b></p>
                    <ul class="marked">
                        <li>объем инвестиций</li>
                        <li>выручку</li>
                        <li>расходы</li>
                    </ul>
                </div>

            </div>
            <div class="cat-promo__image">
                <img src="{{image}}" alt="Пивоварня">
            </div>
        </div>
    </div>
</section>