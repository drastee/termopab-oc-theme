<section class="contacts">
    <div class="container">
        <div class="contacts__inner">
            <div class="contacts__start">
                <h1 class="contacts__title section-title">{{ contacts_title|default('') }}</h1>
                <div class="address">
                    {% if contacts_address_1|default('') %}
                    <p class="address__title">{{ contacts_address_1 }}</p>
                    {% endif %}
                    {% if contacts_address_2|default('') %}
                    <p class="address__note">{{ contacts_address_2 }}</p>
                    {% endif %}
                </div>
                <div class="contacts__columns">
                    <div class="contacts__phones-wrapper">            
                        {% include "@components/phones-styled/_phones-styled.twig" with {
                            telephones: telephones|default([])
                        } %}
                        {% include "@components/shedule-styled/_shedule-styled.twig" with {
                            schedule: schedule|default('')
                        } %}
                    </div>
                    <div class="contacts__social-wrapper">
                        {% if email|default('') %}
                        <a href="mailto:{{ email }}" class="contacts__email">
                            {{ email|upper }}
                        </a>
                        {% endif %}
                        {% include "@components/social-buttons/_social-buttons.twig" with {
                            social_links: footer_social_links|default({})
                        } %}
                    </div>
                </div>
            </div>
            <div class="contacts__end">
                <div class="contacts__badge">
                    <img src="{{ base }}extension/termopab/catalog/view/image/logo-large.webp" class="logo-large js-rotate-item" alt="Termopab badge">
                    <img src="{{ base }}extension/termopab/catalog/view/image/logo-large-shadow.webp" class="logo-shadow" alt="Termopab badge">
                </div>
            </div>
        </div>
    </div>
</section>