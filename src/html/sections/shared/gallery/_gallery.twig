<section class="gallery">
<div class="gallery__images">
            
            {# Запускаем цикл по массиву. Поддержка: URL (string) или {href, src} #}
            {% for image in images %}
                {% set href = image.href is defined ? image.href : image %}
                {% set src = image.src is defined ? image.src : image %}
                <a href="{{ href }}" data-fancybox="gallery">
                    <img src="{{ src }}" alt="" loading="lazy">
                </a>
            {% endfor %}
            
        </div>
    <div class="marquee-wrapper">
        {% include "@components/marquee/_marquee.twig" %}
    </div>
</section>