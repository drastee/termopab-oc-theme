<section class="intro">
    <div class="container intro__inner">
        <div class="intro__content">
            <p class="intro__title">{{ title|default('Lorem Ipsum is simply dummy text of the printing and typesetting industry') }}</p>
            <p class="intro__text">{{ text|default('Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry\'s standard dummy text ever since the 1500s.') }}</p>
        </div>
        <div class="intro__badge">
            <img src="/src/assets/images/logo-large.webp" class="logo-large js-rotate-item" alt="Termopab badge">
            <img src="/src/assets/images/logo-large-shadow.webp" class="logo-shadow" alt="Termopab badge">
        </div>
    </div>

</section>
