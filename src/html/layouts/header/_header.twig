        ]},
        { name: "Бродильний цех", href: "/category/fermentation", image: "", children: [] },
        { name: "Комплектуючі товари", href: "/category/components", image: "/src/assets/images/subcategory-bg-mobile.webp", children: [
            { name: "Варильний порядок", href: "/category/brewing" },
            { name: "Кег/СІП Мийки", href: "/category/keg-washers" },
