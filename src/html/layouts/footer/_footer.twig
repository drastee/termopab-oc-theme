<footer class="footer">
    <div class="container footer__top">

        <!-- LEFT -->
        <div class="footer__left">
            <h2 class="footer__brand">Воп</h2>

            {% include "@components/phones-styled/_phones-styled.twig" with {
                telephones: ['+30 (067) 409-91-61', '+30 (067) 409-91-61']
            } %}
            {% include "@components/shedule-styled/_shedule-styled.twig" with {
                schedule: 'Пн — Пт з 10:00 до 18:00<br>Сб з 9:00 до 16:00'
            } %}


            <button type="button" class="footer__button btn btn-transparent open-callback-btn">Зателефонувати мені</button>
            <hr>
            <a href="mailto:info@termopab.com" class="footer__email">
                INFO@TERMOPAB.COM
            </a>
        </div>

        <!-- RIGHT SIDE -->
        <div class="footer__right">
            <div class="footer__right-top">
                <div class="footer__location">
                    <p class="footer__address">
                        <svg class="footer__icon-location"><use href="#icon-location"></use></svg>
                        УКРАЇНА, КИЇВ
                    </p>
                    <p class="footer__worknote">
                        Працюємо по всій Україні та Європі
                    </p>
                </div>
                <div class="footer_socials_wrapper">
                    {% include "@components/social-buttons/_social-buttons.twig" %}  
                </div>
            </div>
            <div class="footer__right-bottom">
                {% set footer_menu = footer_menu|default([
                    { name: "Пивоварні", href: "/category/breweries" },
                    { name: "Бродильний цех", href: "/category/fermentation" },
                    { name: "Комплектуючі товари", href: "/category/components" },
                    { name: "Проекти", href: "/projects" },
                    { name: "Відгуки", href: "/testimonials" },
                    { name: "Огляди пивоварень", href: "/testimonial" },
                    { name: "Про компанію", href: "/about" },
                    { name: "Новини", href: "/news" },
                    { name: "Контакти", href: "/contacts" }
                ]) %}
                <ul class="footer__menu">
                    {% for item in footer_menu %}
                    <li><a href="{{ item.href }}">{{ item.name }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>


    </div>

    <!-- BOTTOM -->
    <div class="footer__bottom container">
        <div class="footer__bottom-inner">
            <div class="footer__copyright">
                © 2025 Термопаб
            </div>

            <a href="#" class="footer__privacy">Політика конфіденційності</a>

            <div class="footer__payments">
                <img src="/src/assets/images/payments/privat.webp" alt="Privat">
                <img src="/src/assets/images/payments/visa.webp" alt="Visa">
                <img src="/src/assets/images/payments/liqpay.webp" alt="Liqpay">
                <img src="/src/assets/images/payments/mastercard.webp" alt="Mastercard">
            </div>
        </div>
    </div>
</footer>
